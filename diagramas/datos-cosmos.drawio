<mxfile host="frasohome-demos" compressed="false"><diagram id="datos-cosmos" name="FraSoHome Live · Cosmos DB · contenedores y su relación con SQL"><mxGraphModel dx="1180" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="FraSoHome Live · Cosmos DB · contenedores y su relación con SQL" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#263238;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1140" height="30" as="geometry"/></mxCell><mxCell id="c_carritos" value="&lt;b&gt;carritos&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#607D8B&quot; style=&quot;font-size:10px&quot;&gt;/pk = cliente · los crea la web&lt;/font&gt;&lt;hr&gt;id, pk  (cliente)&lt;br&gt;customer_id  → crm.customer&lt;br&gt;lineas  [ {product_id → catalog.product, cantidad} ]&lt;br&gt;cupon  → mkt.coupon.coupon_code&lt;br&gt;actualizado" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#2E7D32;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="360" height="123" as="geometry"/></mxCell><mxCell id="c_eventos_web" value="&lt;b&gt;eventos_web&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#607D8B&quot; style=&quot;font-size:10px&quot;&gt;/pk = sesión · 9.030 documentos&lt;/font&gt;&lt;hr&gt;event_id · session_id (pk)&lt;br&gt;fecha_hora_evento&lt;br&gt;customer_id  → crm.customer&lt;br&gt;product_id  → catalog.product&lt;br&gt;order_id  → sales.online_order&lt;br&gt;tipo_evento, page_type, categoria, search_term&lt;br&gt;cookie_id, device_id, utm_source, utm_medium&lt;br&gt;valor_evento_eur, consent_analytics" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#2E7D32;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="400" y="60" width="360" height="168" as="geometry"/></mxCell><mxCell id="c_feedback" value="&lt;b&gt;feedback&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#607D8B&quot; style=&quot;font-size:10px&quot;&gt;/pk = cliente · 850 documentos&lt;/font&gt;&lt;hr&gt;feedback_id · fecha_feedback&lt;br&gt;customer_id (pk)  → crm.customer&lt;br&gt;order_id  → sales.online_order&lt;br&gt;product_id  → catalog.product&lt;br&gt;tipo_feedback, rating_1_5, nps_0_10&lt;br&gt;sentimiento, tema_principal, texto_feedback&lt;br&gt;publicado_flag, respondido_flag, respuesta_marca" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#2E7D32;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="780" y="60" width="360" height="153" as="geometry"/></mxCell><mxCell id="c_atencion_cliente" value="&lt;b&gt;atencion_cliente&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#607D8B&quot; style=&quot;font-size:10px&quot;&gt;/pk = cliente · 560 documentos&lt;/font&gt;&lt;hr&gt;service_ticket_id · fecha_apertura&lt;br&gt;customer_id (pk)  → crm.customer&lt;br&gt;order_id  → sales.online_order&lt;br&gt;store_id  → store.store&lt;br&gt;tipo_caso, prioridad, canal_soporte&lt;br&gt;estado_resolucion, sla_horas, csat_1_5&lt;br&gt;importe_compensacion_eur, cupon_compensacion&lt;br&gt;conversacion  [ {autor, fecha, texto} ]" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#2E7D32;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="20" y="270" width="360" height="168" as="geometry"/></mxCell><mxCell id="c_senales_identidad" value="&lt;b&gt;senales_identidad&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#607D8B&quot; style=&quot;font-size:10px&quot;&gt;/pk = cliente o SIN_CLIENTE · 411 documentos&lt;/font&gt;&lt;hr&gt;identity_signal_id · fecha_evento&lt;br&gt;customer_id_candidato (pk)  → crm.customer&lt;br&gt;   (SIN_CLIENTE si no está asignada)&lt;br&gt;customer_id_raw (como llegó del origen)&lt;br&gt;fuente_sistema, tipo_senal&lt;br&gt;email_hash, telefono_hash&lt;br&gt;tarjeta_fidelizacion_id, store_id → store.store&lt;br&gt;confianza_origen" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#2E7D32;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="400" y="270" width="360" height="168" as="geometry"/></mxCell><mxCell id="c_eventos_campana" value="&lt;b&gt;eventos_campana&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#607D8B&quot; style=&quot;font-size:10px&quot;&gt;/pk = campaña · 935 documentos&lt;/font&gt;&lt;hr&gt;event_id · contact_id&lt;br&gt;campaign_id (pk)  → mkt.campaign&lt;br&gt;customer_id  → crm.customer&lt;br&gt;fecha_evento, tipo_evento&lt;br&gt;revenue_atribuido_eur&lt;br&gt;margen_atribuido_eur, device_type" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#AD1457;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="780" y="270" width="360" height="138" as="geometry"/></mxCell><mxCell id="c_creatividades" value="&lt;b&gt;creatividades&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#607D8B&quot; style=&quot;font-size:10px&quot;&gt;/pk = campaña · 78 documentos&lt;/font&gt;&lt;hr&gt;creative_id&lt;br&gt;campaign_id (pk)  → mkt.campaign&lt;br&gt;microsegmento, canal, tono&lt;br&gt;beneficio_principal, cta, asunto&lt;br&gt;copy_corto, copy_largo, prueba_social&lt;br&gt;guardrail_legal&lt;br&gt;open_rate, ctr, cvr" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#AD1457;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="20" y="480" width="360" height="153" as="geometry"/></mxCell><mxCell id="c_encuesta_clima" value="&lt;b&gt;encuesta_clima&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#607D8B&quot; style=&quot;font-size:10px&quot;&gt;/pk = empleado · 6.580 documentos&lt;/font&gt;&lt;hr&gt;respuesta_id · oleada · fecha_encuesta&lt;br&gt;employee_id (pk)  → hr.employee&lt;br&gt;dimension, question_code&lt;br&gt;score  (1 a 5)&lt;br&gt;comentario_abierto" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#4527A0;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="400" y="480" width="360" height="123" as="geometry"/></mxCell><mxCell id="c_entrevistas_salida" value="&lt;b&gt;entrevistas_salida&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#607D8B&quot; style=&quot;font-size:10px&quot;&gt;/pk = empleado · 155 documentos&lt;/font&gt;&lt;hr&gt;exit_interview_id&lt;br&gt;employee_id (pk)  → hr.employee&lt;br&gt;fecha_salida, tipo_salida&lt;br&gt;motivo_salida_rrhh&lt;br&gt;comentario_salida&lt;br&gt;recomendaria_empresa_1_10" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#4527A0;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="780" y="480" width="360" height="138" as="geometry"/></mxCell><mxCell id="n0" value="Azure Cosmos DB · base «frasohome» · 9 contenedores&lt;br&gt;Clave de partición /pk en todos, 1.000 RU/s compartidas, sin TTL, documentos planos en lo que se analiza (solo se anida la conversación de atención y las líneas del carrito).&lt;br&gt;Cada documento lleva id, pk y origen (carga_inicial o web). «→» indica el campo que se corresponde con la clave de una tabla SQL; no hay claves foráneas entre las dos bases." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=11;fillColor=#F5F5F5;strokeColor=#424242;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="20" y="660" width="1120" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>