dFill=0;startFill=0;html=1;strokeColor=#78909C;strokeWidth=1.3;fontSize=10;fontColor=#546E7A;" edge="1" parent="1" source="inventory.stock_level" target="store.store"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r7" value="product_id" style="endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;html=1;strokeColor=#78909C;strokeWidth=1.3;fontSize=10;fontColor=#546E7A;" edge="1" parent="1" source="inventory.stock_level" target="catalog.product"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r8" value="" style="endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;html=1;strokeColor=#78909C;strokeWidth=1.3;fontSize=10;fontColor=#546E7A;dashed=1;" edge="1" parent="1" source="inventory.stock_movement" target="store.store"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n0" value="Qué hay aquí&lt;br&gt;returns: cabecera y líneas de devolución, de tienda y online. Se reembolsa y, al reembolsar, la mercancía vuelve al stock.&lt;br&gt;inventory: stock_level es el stock vivo (en mano, reservado, en tránsito, mínimo); stock_snapshot es la foto diaria que sale del cierre;&lt;br&gt;stock_movement es el libro de movimientos. Sus store_id y product_id no son claves foráneas declaradas.&lt;br&gt;Línea de puntos: relación lógica sin FK." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=11;fillColor=#F5F5F5;strokeColor=#424242;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="20" y="560" width="700" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>