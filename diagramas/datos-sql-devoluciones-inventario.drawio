<mxfile host="frasohome-demos" compressed="false"><diagram id="datos-sql-devoluciones-inventario" name="FraSoHome Live · SQL · devoluciones e inventario"><mxGraphModel dx="1420" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="FraSoHome Live · SQL · devoluciones e inventario" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#263238;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1380" height="30" as="geometry"/></mxCell><mxCell id="crm.customer" value="&lt;b&gt;crm.customer&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; customer_id  nvarchar(50)&lt;br&gt;clientes (ver ventas)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#1565C0;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="300" height="64" as="geometry"/></mxCell><mxCell id="returns.return_header" value="&lt;b&gt;returns.return_header&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#607D8B&quot; style=&quot;font-size:10px&quot;&gt;389 filas tras la carga inicial&lt;/font&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; return_id  nvarchar(50)&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; store_id  nvarchar(50)&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; customer_id  nvarchar(50)&lt;br&gt;returned_at  datetime2(0)&lt;br&gt;return_channel  nvarchar(50)&lt;br&gt;original_ticket_id  nvarchar(50)&lt;br&gt;original_order_id  nvarchar(50)&lt;br&gt;return_status  nvarchar(50)&lt;br&gt;… y 6 columnas más" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#AD1457;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="380" y="60" width="300" height="183" as="geometry"/></mxCell><mxCell id="returns.return_line" value="&lt;