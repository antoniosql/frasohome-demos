<mxfile host="frasohome-demos" compressed="false"><diagram id="datos-sql-aplicacion" name="FraSoHome Live · SQL · aplicación (usuarios, sesiones, outbox)"><mxGraphModel dx="1420" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="FraSoHome Live · SQL · aplicación (usuarios, sesiones, outbox)" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#263238;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1380" height="30" as="geometry"/></mxCell><mxCell id="app.app_user" value="&lt;b&gt;app.app_user&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; user_id  int&lt;br&gt;login  nvarchar(100)&lt;br&gt;display_name  nvarchar(200)&lt;br&gt;password_hash  varbinary(64)&lt;br&gt;password_salt  varbinary(32)&lt;br&gt;scrypt_n  int&lt;br&gt;scrypt_r  int&lt;br&gt;scrypt_p  int&lt;br&gt;is_active  bit&lt;br&gt;… y 6 columnas más" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#E65100;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="380" y="280" width="300" height="184" as="geometry"/></mxCell><mxCell id="app.user_role" value="&lt;b&gt;app.user_role&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK, FK&lt;/b&gt; user_id  int&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; role_name  nvarchar(30)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#E65100;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="300" height="64" as="geometry"/></mxCell><mxCell id="app.user_scope" value="&lt;b&gt;app.user_scope&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK, FK&lt;/b&gt; user_id  int&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; scope_type  nvarchar(20)&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; scope_value  nvarchar(50)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#E65100;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="20" y="280" width="300" height="79" as="geometry"/></mxCell><mxCell id="app.user_session" value="&lt;b&gt;app.user_session&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; session_hash  varbinary(32)&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; user_id  int&lt;br&gt;created_at  datetime2(0)&lt;br&gt;expires_at  datetime2(0)&lt;br&gt;user_agent  nvarchar(300)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#E65100;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="20" y="500" width="300" height="109" as="geometry"/></mxCell><mxCell id="app.idempotency_key" value="&lt;b&gt;app.idempotency_key&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; idempotency_key  nvarchar(100)&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; user_id  int&lt;br&gt;request_path  nvarchar(200)&lt;br&gt;status_code  int&lt;br&gt;response_body  nvarchar(max)&lt;br&gt;created_at  datetime2(0)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#E65100;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="740" y="60" width="300" height="124" as="geometry"/></mxCell><mxCell id="app.outbox" value="&lt;b&gt;app.outbox&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; outbox_id  bigint&lt;br&gt;container_name  nvarchar(50)&lt;br&gt;operation  nvarchar(10)&lt;br&gt;document_json  nvarchar(max)&lt;br&gt;created_at  datetime2(0)&lt;br&gt;attempts  int&lt;br&gt;last_error  nvarchar(1000)&lt;br&gt;sent_at  datetime2(0)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#E65100;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="740" y="280" width="300" height="154" as="geometry"/></mxCell><mxCell id="app.audit_log" value="&lt;b&gt;app.audit_log&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; audit_id  bigint&lt;br&gt;logged_at  datetime2(0)&lt;br&gt;user_login  nvarchar(100)&lt;br&gt;action_name  nvarchar(100)&lt;br&gt;entity_name  nvarchar(100)&lt;br&gt;entity_id  nvarchar(100)&lt;br&gt;detail  nvarchar(2000)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#E65100;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="740" y="500" width="300" height="139" as="geometry"/></mxCell><mxCell id="app.id_counter" value="&lt;b&gt;app.id_counter&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; kind  nvarchar(30)&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; period_key  smallint&lt;br&gt;prefix_template  nvarchar(30)&lt;br&gt;number_width  tinyint&lt;br&gt;next_value  bigint" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#424242;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="380" y="60" width="300" height="109" as="geometry"/></mxCell><mxCell id="app.id_kind" value="&lt;b&gt;app.id_kind&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; kind  nvarchar(30)&lt;br&gt;prefix_template  nvarchar(30)&lt;br&gt;number_width  tinyint&lt;br&gt;per_year  bit" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#424242;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="380" y="500" width="300" height="94" as="geometry"/></mxCell><mxCell id="r0" value="user_id" style="endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;html=1;strokeColor=#78909C;strokeWidth=1.3;fontSize=10;fontColor=#546E7A;" edge="1" parent="1" source="app.user_role" target="app.app_user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r1" value="user_id" style="endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;html=1;strokeColor=#78909C;strokeWidth=1.3;fontSize=10;fontColor=#546E7A;" edge="1" parent="1" source="app.user_scope" target="app.app_user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r2" value="user_id" style="endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;html=1;strokeColor=#78909C;strokeWidth=1.3;fontSize=10;fontColor=#546E7A;" edge="1" parent="1" source="app.user_session" target="app.app_user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r3" value="user_id (lógica)" style="endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;html=1;strokeColor=#78909C;strokeWidth=1.3;fontSize=10;fontColor=#546E7A;dashed=1;" edge="1" parent="1" source="app.idempotency_key" target="app.app_user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r4" value="kind (lógica)" style="endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;html=1;strokeColor=#78909C;strokeWidth=1.3;fontSize=10;fontColor=#546E7A;dashed=1;" edge="1" parent="1" source="app.id_counter" target="app.id_kind"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n0" value="Aplicación (esquema app)&lt;br&gt;Lo que necesita la web además del negocio:&lt;br&gt;• usuarios, roles y ámbitos (a qué cliente, tienda&lt;br&gt;  o empleado está atado cada uno)&lt;br&gt;• sesiones: solo se guarda el hash del token&lt;br&gt;• Idempotency-Key: repetir un cobro no lo duplica&lt;br&gt;• outbox: eventos pendientes de enviar a Cosmos&lt;br&gt;• auditoría de cambios&lt;br&gt;• contadores de identificadores (C0001, O-…)&lt;br&gt;&lt;br&gt;Contiene contraseñas con scrypt y sesiones:&lt;br&gt;no se da lectura a este esquema (ver conexión)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=11;fillColor=#FFF8E1;strokeColor=#E65100;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="1100" y="60" width="300" height="330" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>