l><mxCell id="fin.transaction_cost" value="&lt;b&gt;fin.transaction_cost&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#607D8B&quot; style=&quot;font-size:10px&quot;&gt;1.829 filas tras la carga inicial&lt;/font&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; transaction_cost_id  nvarchar(30)&lt;br&gt;document_type  nvarchar(10)&lt;br&gt;order_id  nvarchar(50)&lt;br&gt;ticket_id  nvarchar(50)&lt;br&gt;customer_id  nvarchar(50)&lt;br&gt;transaction_at  datetime2(0)&lt;br&gt;… y 15 columnas más" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#424242;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="1100" y="500" width="300" height="153" as="geometry"/></mxCell><mxCell id="crm.customer" value="&lt;b&gt;crm.customer&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; customer_id  nvarchar(50)&lt;br&gt;clientes (ver ventas)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#1565C0;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="740" y="60" width="300" height="64" as="geometry"/></mxCell><mxCell id="mkt.customer_store_affinity" value="&lt;b&gt;mkt.customer_store_affinity&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#607D8B&quot; style=&quot;font-size:10px&quot;&gt;100 filas tras la carga inicial&lt;/font&gt;&lt;hr&gt;&lt;b&gt;PK, FK&lt;/b&gt; customer_id  nvarchar(50)&lt;br&gt;preferred_store_id  nvarchar(50)&lt;br&gt;nearest_store_id  nvarchar(50)&lt;br&gt;nearest_store_km  decimal(9,1)&lt;br&gt;store_visits_12m  int&lt;br&gt;store_spend_12m_eur  decimal(12,2)&lt;br&gt;online_spend_12m_eur  decimal(12,2)&lt;br&gt;… y 7 columnas más" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#AD1457;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="740" y="280" width="300" height="168" as="geometry"/></mxCell><mxCell id="store.store" value="&lt;b&gt;store.store&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; store_id  nvarchar(50)&lt;br&gt;tiendas (ver ventas)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#2E7D32;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="740" y="500" width="300" height="64" as="geometry"/></mxCell><mxCell id="r0" value="campaign_id" style="endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;html=1;strokeColor=#78909C;strokeWidth=1.3;fontSize=10;fontColor=#546E7A;" edge="1" parent="1" source="mkt.campaign_contact" target="mkt.campaign"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r1" value="customer_id" style="endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;html=1;strokeColor=#78909C;strokeWidth=1.3;fontSize=10;fontColor=#546E7A;" edge="1" parent="1" source="mkt.campaign_contact" target="crm.customer"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r2" value="campaign_id" style="endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;html=1;strokeColor=#78909C;strokeWidth=1.3;fontSize=10;fontColor=#546E7A;" edge="1" parent="1" source="mkt.coupon" target="mkt.campaign"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r3" value="customer_id" style="endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;html=1;strokeColor=#78909C;strokeWidth=1.3;fontSize=10;fontColor=#546E7A;" edge="1" parent="1" source="mkt.coupon" target="crm.customer"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r4" value="related_campaign_id" style="endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;html=1;strokeColor=#78909C;strokeWidth=1.3;fontSize=10;fontColor=#546E7A;" edge="1" parent="1" source="mkt.promotion" target="mkt.campaign"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r5" value="store_id" style="endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;html=1;strokeColor=#78909C;strokeWidth=1.3;fontSize=10;fontColor=#546E7A;" edge="1" parent="1" source="mkt.promotion" target="store.store"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r6" value="target_store_id" style="endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;html=1;strokeColor=#78909C;strokeWidth=1.3;fontSize=10;fontColor=#546E7A;" edge="1" parent="1" source="mkt.campaign" target="store.store"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r7" value="customer_id" style="endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;html=1;strokeColor=#78909C;strokeWidth=1.3;fontSize=10;fontColor=#546E7A;" edge="1" parent="1" source="mkt.customer_store_affinity" target="crm.customer"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n0" value="Marketing y costes&lt;br&gt;Una campaña tiene contactos (el grupo de control&lt;br&gt;es experiment_group = control), cupones y&lt;br&gt;promociones relacionadas.&lt;br&gt;&lt;br&gt;mkt.coupon.coupon_instance_id se guarda en el&lt;br&gt;pedido o ticket donde se canjea. Sus eventos y&lt;br&gt;creatividades viven en Cosmos DB (ver&lt;br&gt;datos-cosmos).&lt;br&gt;&lt;br&gt;fin.transaction_cost: coste por transacción y canal." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=11;fillColor=#F5F5F5;strokeColor=#424242;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="1100" y="60" width="300" height="330" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>