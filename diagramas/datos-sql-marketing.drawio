<mxfile host="frasohome-demos" compressed="false"><diagram id="datos-sql-marketing" name="FraSoHome Live · SQL · marketing, cupones y costes"><mxGraphModel dx="1420" dy="740" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="740" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="FraSoHome Live · SQL · marketing, cupones y costes" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#263238;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1380" height="30" as="geometry"/></mxCell><mxCell id="mkt.campaign_contact" value="&lt;b&gt;mkt.campaign_contact&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#607D8B&quot; style=&quot;font-size:10px&quot;&gt;480 filas tras la carga inicial&lt;/font&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; contact_id  nvarchar(30)&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; campaign_id  nvarchar(30)&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; customer_id  nvarchar(50)&lt;br&gt;contacted_at  datetime2(0)&lt;br&gt;contact_channel  nvarchar(20)&lt;br&gt;experiment_group  nvarchar(20)&lt;br&gt;is_control  bit&lt;br&gt;assigned_segment  nvarchar(50)&lt;br&gt;… y 15 columnas más" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#AD1457;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="300" height="183" as="geometry"/></mxCell><mxCell id="mkt.coupon" value="&lt;b&gt;mkt.coupon&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#607D8B&quot; style=&quot;font-size:10px&quot;&gt;367 filas tras la carga inicial&lt;/font&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; coupon_instance_id  nvarchar(30)&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; campaign_id  nvarchar(30)&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; customer_id  nvarchar(50)&lt;br&gt;coupon_code  nvarchar(30)&lt;br&gt;issued_at  datetime2(0)&lt;br&gt;valid_from  datetime2(0)&lt;br&gt;valid_to  dateti