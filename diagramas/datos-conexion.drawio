<mxfile host="frasohome-demos" compressed="false"><diagram id="datos-conexion" name="FraSoHome Live · cómo conectar con los datos desde otras demos"><mxGraphModel dx="1240" dy="640" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="FraSoHome Live · cómo conectar con los datos desde otras demos" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#263238;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="30" as="geometry"/></mxCell><mxCell id="k1" value="&lt;b&gt;Python&lt;/b&gt;&lt;hr&gt;pandas y notebooks&lt;br&gt;mssql-python · pyodbc · azure-cosmos" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#424242;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="20" y="290" width="250" height="64" as="geometry"/></mxCell><mxCell id="k2" value="&lt;b&gt;Power BI y Excel&lt;/b&gt;&lt;hr&gt;Importar o DirectQuery&lt;br&gt;conector de Azure SQL" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#424242;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="250" height="64" as="geometry"/></mxCell><mxCell id="k3" value="&lt;b&gt;Apps de demo&lt;/b&gt;&lt;hr&gt;Streamlit, informes, APIs&lt;br&gt;cadena de conexión en variables" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#424242;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="20" y="400" width="250" height="64" as="geometry"/></mxCell><mxCell id="k4" value="&lt;b&gt;Agentes de IA&lt;/b&gt;&lt;hr&gt;texto a SQL con usuario de solo lectura&lt;br&gt;nunca con fsh_api ni con el admin" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#424242;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="20" y="170" width="250" height="64" as="geometry"/></mxCell><mxCell id="k5" value="&lt;b&gt;Herramientas&lt;/b&gt;&lt;hr&gt;VS Code (mssql), SSMS, sqlcmd&lt;br&gt;Data Explorer de Cosmos DB" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#424242;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="20" y="500" width="250" height="64" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;Azure SQL · acceso&lt;/b&gt;&lt;hr&gt;1. Tu IP en el firewall de Azure SQL&lt;br&gt;   az sql server firewall-rule create&lt;br&gt;2. Usuario de solo lectura en la base&lt;br&gt;   (o tu identidad Microsoft Entra)&lt;br&gt;3. Cadena con Encrypt=yes y reintentos&lt;br&gt;4. La primera conexión despierta la base" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#E65100;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="380" y="90" width="330" height="124" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;Cosmos DB · acceso&lt;/b&gt;&lt;hr&gt;1. Clave de solo lectura de la cuenta&lt;br&gt;   az cosmosdb keys list --type read-only-keys&lt;br&gt;2. Endpoint y base «frasohome»&lt;br&gt;3. Consultas con pk siempre que se pueda&lt;br&gt;4. Cabe en 1.000 RU/s compartidas:&lt;br&gt;   evita consultas entre particiones grandes" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#E65100;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="380" y="330" width="330" height="124" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;Azure SQL Database&lt;/b&gt;&lt;hr&gt;Base frasohome-oltp (plan gratuito, autopausa)&lt;br&gt;esquemas: crm, catalog, store, sales, returns,&lt;br&gt;inventory, hr, mkt, fin, ref, xref, rag, meta,&lt;br&gt;lab, quality (no app)&lt;br&gt;puerto 1433 · TLS obligatorio" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#00695C;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="830" y="90" width="360" height="109" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;Azure Cosmos DB&lt;/b&gt;&lt;hr&gt;Cuenta con free tier, base «frasohome»&lt;br&gt;9 contenedores, partición /pk&lt;br&gt;https://&lt;cuenta&gt;.documents.azure.com:443/" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#00695C;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="830" y="330" width="360" height="79" as="geometry"/></mxCell><mxCell id="r0" value="" style="endArrow=block;endFill=1;startArrow=none;html=1;strokeColor=#78909C;strokeWidth=1.3;fontSize=10;fontColor=#546E7A;" edge="1" parent="1" source="k1" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r1" value="" style="endArrow=block;endFill=1;startArrow=none;html=1;strokeColor=#78909C;strokeWidth=1.3;fontSize=10;fontColor=#546E7A;" edge="1" parent="1" source="k2" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r2" value="" style="endArrow=block;endFill=1;startArrow=none;html=1;strokeColor=#78909C;strokeWidth=1.3;fontSize=10;fontColor=#546E7A;" edge="1" parent="1" source="k3" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r3" value="" style="endArrow=block;endFill=1;startArrow=none;html=1;strokeColor=#78909C;strokeWidth=1.3;fontSize=10;fontColor=#546E7A;" edge="1" parent="1" source="k4" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r4" value="" style="endArrow=block;endFill=1;startArrow=none;html=1;strokeColor=#78909C;strokeWidth=1.3;fontSize=10;fontColor=#546E7A;" edge="1" parent="1" source="k5" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r5" value="" style="endArrow=block;endFill=1;startArrow=none;html=1;strokeColor=#78909C;strokeWidth=1.3;fontSize=10;fontColor=#546E7A;" edge="1" parent="1" source="k1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r6" value="" style="endArrow=block;endFill=1;startArrow=none;html=1;strokeColor=#78909C;strokeWidth=1.3;fontSize=10;fontColor=#546E7A;" edge="1" parent="1" source="k3" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r7" value="" style="endArrow=block;endFill=1;startArrow=none;html=1;strokeColor=#78909C;strokeWidth=1.3;fontSize=10;fontColor=#546E7A;" edge="1" parent="1" source="k5" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r8" value="TLS · 1433" style="endArrow=block;endFill=1;startArrow=none;html=1;strokeColor=#78909C;strokeWidth=1.3;fontSize=10;fontColor=#546E7A;" edge="1" parent="1" source="p1" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r9" value="HTTPS · 443" style="endArrow=block;endFill=1;startArrow=none;html=1;strokeColor=#78909C;strokeWidth=1.3;fontSize=10;fontColor=#546E7A;" edge="1" parent="1" source="p2" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n0" value="Dónde están los valores reales&lt;br&gt;Servidor, endpoint y nombres: .local\frasohome-live\estado.json (Git lo ignora) o az sql server list / az cosmosdb list.&lt;br&gt;No se publican en el repositorio. Las contraseñas y claves tampoco: variables de entorno o gestor de secretos." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=11;fillColor=#F5F5F5;strokeColor=#424242;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="380" y="520" width="810" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>