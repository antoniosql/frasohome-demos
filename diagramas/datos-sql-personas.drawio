<mxfile host="frasohome-demos" compressed="false"><diagram id="datos-sql-personas" name="FraSoHome Live · SQL · personas (RR. HH.)"><mxGraphModel dx="1420" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="FraSoHome Live · SQL · personas (RR. HH.)" style="text;html=1;fontSize=18;fontStyle=1;fontColor=#263238;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1380" height="30" as="geometry"/></mxCell><mxCell id="hr.employee_movement" value="&lt;b&gt;hr.employee_movement&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#607D8B&quot; style=&quot;font-size:10px&quot;&gt;1.437 filas tras la carga inicial&lt;/font&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; movement_id  nvarchar(20)&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; employee_id  nvarchar(20)&lt;br&gt;moved_at  date&lt;br&gt;movement_type  nvarchar(50)&lt;br&gt;department_from  nvarchar(100)&lt;br&gt;department_to  nvarchar(100)&lt;br&gt;level_from  nvarchar(50)&lt;br&gt;level_to  nvarchar(50)&lt;br&gt;… y 4 columnas más" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#4527A0;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="300" height="183" as="geometry"/></mxCell><mxCell id="hr.absence" value="&lt;b&gt;hr.absence&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#607D8B&quot; style=&quot;font-size:10px&quot;&gt;1.521 filas tras la carga inicial&lt;/font&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; absence_id  nvarchar(20)&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; employee_id  nvarchar(20)&lt;br&gt;start_date  date&lt;br&gt;end_date  date&lt;br&gt;absence_type  nvarchar(50)&lt;br&gt;working_days  int&lt;br&gt;justified  nvarchar(20)&lt;br&gt;… y 1 columnas más" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;ver