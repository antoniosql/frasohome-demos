="740" y="60" width="300" height="168" as="geometry"/></mxCell><mxCell id="hr.performance_review" value="&lt;b&gt;hr.performance_review&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#607D8B&quot; style=&quot;font-size:10px&quot;&gt;1.132 filas tras la carga inicial&lt;/font&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; review_id  nvarchar(20)&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; employee_id  nvarchar(20)&lt;br&gt;review_cycle  char(4)&lt;br&gt;reviewed_at  date&lt;br&gt;overall_score  decimal(3,1)&lt;br&gt;objectives_pct  decimal(6,1)&lt;br&gt;competencies_score  decimal(3,1)&lt;br&gt;… y 4 columnas más" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#4527A0;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="740" y="270" width="300" height="168" as="geometry"/></mxCell><mxCell id="hr.compensation" value="&lt;b&gt;hr.compensation&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#607D8B&quot; style=&quot;font-size:10px&quot;&gt;1.641 filas tras la carga inicial&lt;/font&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; payroll_id  nvarchar(20)&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; employee_id  nvarchar(20)&lt;br&gt;period_month  char(7)&lt;br&gt;base_salary_eur  decimal(12,2)&lt;br&gt;variable_salary_eur  decimal(12,2)&lt;br&gt;increase_pct  decimal(6,2)&lt;br&gt;currency_code  char(3)&lt;br&gt;… y 2 columnas más" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;fillColor=#FFFFFF;strokeColor=#4527A0;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="740" y="480" width="300" height="168" as="geometry"/></mxCell><mxCell id="r0" value="employee_id" style="endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;html=1;strokeColor=#78909C;strokeWidth=1.3;fontSize=10;fontColor=#546E7A;" edge="1" parent="1" source="hr.employee_movement" target="hr.employee"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r1" value="employee_id" style="endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;html=1;strokeColor=#78909C;strokeWidth=1.3;fontSize=10;fontColor=#546E7A;" edge="1" parent="1" source="hr.absence" target="hr.employee"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r2" value="employee_id" style="endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;html=1;strokeColor=#78909C;strokeWidth=1.3;fontSize=10;fontColor=#546E7A;" edge="1" parent="1" source="hr.overtime" target="hr.employee"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r3" value="manager_id" style="endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;html=1;strokeColor=#78909C;strokeWidth=1.3;fontSize=10;fontColor=#546E7A;" edge="1" parent="1" source="hr.employee" target="hr.employee"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r4" value="employee_id" style="endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;html=1;strokeColor=#78909C;strokeWidth=1.3;fontSize=10;fontColor=#546E7A;" edge="1" parent="1" source="hr.training" target="hr.employee"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r5" value="employee_id" style="endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;html=1;strokeColor=#78909C;strokeWidth=1.3;fontSize=10;fontColor=#546E7A;" edge="1" parent="1" source="hr.performance_review" target="hr.employee"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r6" value="employee_id" style="endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;html=1;strokeColor=#78909C;strokeWidth=1.3;fontSize=10;fontColor=#546E7A;" edge="1" parent="1" source="hr.compensation" target="hr.employee"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r7" value="employee_id (lógica)" style="endArrow=ERmandOne;startArrow=ERmany;endFill=0;startFill=0;html=1;strokeColor=#78909C;strokeWidth=1.3;fontSize=10;fontColor=#546E7A;dashed=1;" edge="1" parent="1" source="hr.people_analytics_seed" target="hr.employee"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n0" value="Personas&lt;br&gt;hr.employee es el centro: un empleado, su&lt;br&gt;manager (manager_id apunta a otro empleado)&lt;br&gt;y todo lo que le pasa: movimientos, ausencias,&lt;br&gt;horas extra, formación, evaluaciones y salario.&lt;br&gt;&lt;br&gt;Los dos «seed» (gris) llegan de los CSV de&lt;br&gt;People Analytics y no los modifica la web:&lt;br&gt;riesgo de abandono por empleado y rotación&lt;br&gt;mensual por departamento hasta abril de 2026." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=11;fillColor=#F5F5F5;strokeColor=#424242;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="1100" y="60" width="300" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>