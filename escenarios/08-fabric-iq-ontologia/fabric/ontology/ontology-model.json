    { "name": "SaleIncludesProduct", "stage": 4, "source": "StoreSale", "target": "Product", "table": "rel_sale_includes_product", "description": "La venta incluye el producto." },
    { "name": "PaymentSettlesSale", "stage": 4, "source": "Payment", "target": "StoreSale", "table": "rel_payment_settles_sale", "description": "El pago liquida una venta de tienda." },
    { "name": "ReturnForOrder", "stage": 4, "source": "Return", "target": "Order", "table": "rel_return_for_order", "description": "La devolución se vincula a un pedido online." },
    { "name": "ReturnForSale", "stage": 4, "source": "Return", "target": "StoreSale", "table": "rel_return_for_sale", "description": "La devolución se vincula a una venta de tienda." },
    { "name": "ReturnConcernsProduct", "stage": 4, "source": "Return", "target": "Product", "table": "rel_return_concerns_product", "description": "La devolución afecta a un producto." },
    { "name": "InventoryAtStore", "stage": 5, "source": "InventoryPosition", "target": "Store", "table": "rel_inventory_at_store", "description": "La posición de inventario corresponde a una tienda." },
    { "name": "InventoryTracksProduct", "stage": 5, "source": "InventoryPosition", "target": "Product", "table": "rel_inventory_tracks_product", "description": "La posición de inventario mide un producto." },
    { "name": "DemandSignalFromCustomer", "stage": 5, "source": "DemandSignal", "target": "Customer", "table": "rel_signal_from_customer", "description": "La señal se atribuye a un cliente identificado." },
    { "name": "DemandSignalAboutProduct", "stage": 5, "source": "DemandSignal", "target": "Product", "table": "rel_signal_about_product", "description": "La señal expresa interés por un producto." },
    { "name": "DemandSignalLeadsToOrder", "stage": 5, "source": "DemandSignal", "target": "Order", "table": "rel_signal_leads_to_order", "description": "La señal culmina en un pedido conocido." },
    { "name": "CampaignHasContact", "stage": 6, "source": "Campaign", "target": "CampaignContact", "table": "rel_campaign_has_contact", "description": "La campaña genera un contacto." },
    { "name": "ContactAddressesCustomer", "stage": 6, "source": "CampaignContact", "target": "Customer", "table": "rel_contact_addresses_customer", "description": "El contacto se dirige a un cliente." },
    { "name": "ContactRecommendsProduct", "stage": 6, "source": "CampaignContact", "target": "Product", "table": "rel_contact_recommends_product", "description": "El contacto recomienda uno o más productos." },
    { "name": "ContactConvertsToOrder", "stage": 6, "source": "CampaignContact", "target": "Order", "table": "rel_contact_converts_to_order", "description": "El contacto se atribuye a un pedido convertido en 30 días." },
    { "name": "CampaignOffersPromotion", "stage": 6, "source": "Campaign", "target": "Promotion", "table": "rel_campaign_offers_promotion", "description": "La campaña activa una promoción." },
    { "name": "PromotionAtStore", "stage": 6, "source": "Promotion", "target": "Store", "table": "rel_promotion_at_store", "description": "La promoción está restringida a una tienda cuando la fuente así lo indica." }
