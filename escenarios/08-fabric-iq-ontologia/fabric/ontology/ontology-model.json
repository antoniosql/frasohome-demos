{
  "schemaVersion": "1.0",
  "name": "FraSoHomeContext",
  "description": "Vocabulario empresarial FraSoHome para comercio omnicanal, inventario, demanda y marketing.",
  "stages": [
    {
      "stage": 1,
      "name": "Comercio esencial",
      "question": "¿Quién compra qué y mediante qué pedido?"
    },
    {
      "stage": 2,
      "name": "Detalle y clasificación",
      "question": "¿Qué líneas componen el pedido y cómo se clasifica cada producto?"
    },
    {
      "stage": 3,
      "name": "Geografía y preferencia",
      "question": "¿Dónde opera FraSoHome y qué tienda prefiere cada cliente?"
    },
    {
      "stage": 4,
      "name": "Operación de tienda y devoluciones",
      "question": "¿Cómo se conectan venta, pago, tienda, producto y devolución?"
    },
    {
      "stage": 5,
      "name": "Inventario y señales de demanda",
      "question": "¿Qué intención digital coincide con riesgo de stock?"
    },
    {
      "stage": 6,
      "name": "Activación de marketing",
      "question": "¿Qué campaña, contacto y promoción explican una conversión?"
    }
  ],
  "entities": [
    {
      "name": "Customer",
      "stage": 1,
      "table": "iq_customer",
      "keyProperty": "CustomerId",
      "displayProperty": "CustomerName",
      "description": "Persona cliente canónica. Se excluyen email y teléfono de la ontología para no exponer PII al agente.",
      "properties": [
        { "name": "CustomerId", "column": "customer_id", "type": "String" },
        { "name": "CustomerName", "column": "customer_name", "type": "String" },
        { "name": "CustomerTier", "column": "loyalty_tier", "type": "String" },
        { "name": "CustomerPoints", "column": "loyalty_points", "type": "BigInt" },
        { "name": "CustomerCity", "column": "city", "type": "String" },
        { "name": "CustomerProvince", "column": "province", "type": "String" },
        { "name": "CustomerConsent", "column": "marketing_consent", "type": "Boolean" },
        { "name": "CustomerStatus", "column": "customer_status", "type": "String" },
        { "name": "CustomerPreferredChannel", "column": "preferred_channel", "type": "String" }
      ]
    },
    {
      "name": "Order",
      "stage": 1,
      "table": "iq_order",
      "keyProperty": "OrderId",
      "displayProperty": "OrderId",
      "description": "Pedido de comercio electrónico o marketplace realizado por un cliente.",
      "properties": [
        { "name": "OrderId", "column": "order_id", "type": "String" },
        { "name": "OrderDate", "column": "order_date", "type": "DateTime" },
        { "name": "OrderTotal", "column": "order_total", "type": "Double" },
        { "name": "OrderCurrency", "column": "currency", "type": "String" },
        { "name": "OrderShippingCost", "column": "shipping_cost", "type": "Double" },
        { "name": "OrderStatus", "column": "order_status", "type": "String" },
        { "name": "OrderOrigin", "column": "order_origin", "type": "String" },
        { "name": "OrderDestinationCity", "column": "destination_city", "type": "String" }
      ]
    },
    {
      "name": "Product",
      "stage": 1,
      "table": "iq_product",
      "keyProperty": "ProductId",
      "displayProperty": "ProductName",
      "description": "Artículo vendible del catálogo canónico FraSoHome.",
