  "relationships": [
    { "name": "CustomerPlacesOrder", "stage": 1, "source": "Customer", "target": "Order", "table": "rel_customer_places_order", "description": "El cliente realiza el pedido." },
    { "name": "OrderIncludesProduct", "stage": 1, "source": "Order", "target": "Product", "table": "rel_order_includes_product", "description": "Vista simplificada de los productos incluidos en un pedido." },
    { "name": "OrderHasLine", "stage": 2, "source": "Order", "target": "OrderLine", "table": "rel_order_has_line", "description": "El pedido se descompone en líneas." },
    { "name": "LineReferencesProduct", "stage": 2, "source": "OrderLine", "target": "Product", "table": "rel_line_references_product", "description": "La línea referencia el producto vendido." },
    { "name": "ProductInCategory", "stage": 2, "source": "Product", "target": "Category", "table": "rel_product_in_category", "description": "El producto pertenece a una categoría comercial." },
    { "name": "StoreInRegion", "stage": 3, "source": "Store", "target": "Region", "table": "rel_store_in_region", "description": "La tienda opera en una región." },
    { "name": "CustomerPrefersStore", "stage": 3, "source": "Customer", "target": "Store", "table": "rel_customer_prefers_store", "description": "Tienda preferida calculada para el cliente." },
    { "name": "CustomerCompletesSale", "stage": 4, "source": "Customer", "target": "StoreSale", "table": "rel_customer_completes_sale", "description": "El cliente completa una venta identificada en POS." },
