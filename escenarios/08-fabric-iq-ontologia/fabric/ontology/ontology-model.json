        { "name": "ProductId", "column": "product_id", "type": "String" },
        { "name": "ProductName", "column": "product_name", "type": "String" },
        { "name": "ProductCategory", "column": "category_name", "type": "String" },
        { "name": "ProductSubcategory", "column": "subcategory_name", "type": "String" },
        { "name": "ProductBrand", "column": "brand", "type": "String" },
        { "name": "ProductMaterial", "column": "material", "type": "String" },
        { "name": "ProductColor", "column": "color", "type": "String" },
        { "name": "ProductSalePrice", "column": "sale_price", "type": "Double" },
        { "name": "ProductUnitCost", "column": "unit_cost", "type": "Double" },
        { "name": "ProductStatus", "column": "product_status", "type": "String" }
      ]
    },
    {
      "name": "OrderLine",
      "stage": 2,
      "table": "iq_order_line",
      "keyProperty": "OrderLineId",
      "displayProperty": "OrderLineDescription",
      "description": "Detalle comercial que materializa la relación muchos-a-muchos entre pedido y producto.",
      "properties": [
        { "name": "OrderLineId", "column": "order_line_id", "type": "String" },
        { "name": "OrderLineDescription", "column": "line_description", "type": "String" },
        { "name": "OrderLineQuantity", "column": "quantity", "type": "BigInt" },
        { "name": "OrderLineUnitPrice", "column": "unit_price", "type": "Double" },
        { "name": "OrderLineDiscountPct", "column": "discount_pct", "type": "Double" },
        { "name": "OrderLineDiscountAmount", "column": "discount_amount", "type": "Double" },
        { "name": "OrderLineAmount", "column": "line_amount", "type": "Double" }
      ]
    },
    {
      "name": "Category",
      "stage": 2,
      "table": "iq_category",
      "keyProperty": "CategoryId",
