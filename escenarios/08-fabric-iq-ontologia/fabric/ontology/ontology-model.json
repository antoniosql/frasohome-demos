        { "name": "ReturnDate", "column": "return_date", "type": "DateTime" },
        { "name": "ReturnChannel", "column": "return_channel", "type": "String" },
        { "name": "ReturnReason", "column": "return_reason", "type": "String" },
        { "name": "ReturnMethod", "column": "return_method", "type": "String" },
        { "name": "ReturnStatus", "column": "return_status", "type": "String" },
        { "name": "ReturnAmount", "column": "return_amount", "type": "Double" },
        { "name": "ReturnCurrency", "column": "currency", "type": "String" },
        { "name": "ReturnQuantity", "column": "return_quantity", "type": "BigInt" }
